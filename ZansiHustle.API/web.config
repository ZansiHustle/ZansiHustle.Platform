<?xml version="1.0" encoding="utf-8"?>
<!--
  Checked into source deliberately (not SDK-auto-generated) so
  stdoutLogEnabled/stdoutLogFile survive every publish permanently.

  ASP.NET Core SDK publish behaviour: when a web.config already exists in
  the project, `dotnet publish` TRANSFORMS it (only processPath/arguments/
  modules are kept in sync with the actual build output) rather than
  replacing it with a fresh auto-generated one — and a fresh auto-generated
  web.config always defaults to stdoutLogEnabled="false", which is why the
  live 500.30 produced no usable startup log. Custom attributes we set
  below (stdoutLogEnabled, stdoutLogFile) are left exactly as written.

  processPath="dotnet" / arguments=".\ZansiHustle.API.dll" match this
  project's actual deployment model: Microsoft.NET.Sdk.Web, net8.0,
  framework-dependent (no SelfContained/RuntimeIdentifier in the csproj),
  hostingModel defaults to InProcess for SDK-style web projects targeting
  .NET Core 3.0+ (unchanged here, made explicit below).

  Intentionally stdoutLogEnabled="true" for EVERY environment (UAT and
  Production included) — do not add an environment-specific transform
  that flips this to false. Log directory is relative to the deployment
  root (".\logs\stdout") — the physical `logs` folder is created on the
  server separately; this file never references an absolute server path.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore"
             path="*"
             verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\ZansiHustle.API.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <!--
          No secrets here. Environment variables for connection strings /
          provider credentials continue to be set at the IIS Application
          Pool / server level (or appsettings), never in this file.
        -->
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
